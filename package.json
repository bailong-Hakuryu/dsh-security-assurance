{
  "name": "dsh-security-assurance",
  "description": "Evidence-backed application-security assurance for DeepSeek Harness",
  "version": "0.0.0-development",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/types/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./analyzer": {
      "types": "./lib/types/analyzer.d.ts",
      "default": "./lib/analyzer.js"
    },
    "./evaluation": {
      "types": "./lib/types/evaluation.d.ts",
      "default": "./lib/evaluation.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./control-plane-provider": {
      "types": "./lib/types/control-plane-provider.d.ts",
      "default": "./lib/control-plane-provider.js"
    },
    "./host-repository-provider": {
      "types": "./lib/types/host-repository-provider.d.ts",
      "default": "./lib/host-repository-provider.js"
    },
    "./workbench-remote": {
      "types": "./lib/types/workbench-remote.d.ts",
      "default": "./lib/workbench-remote.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/contracts.js",
    "lib/analyzer.js",
    "lib/evaluation.js",
    "lib/tools.js",
    "lib/control-plane-provider.js",
    "lib/host-repository-provider.js",
    "lib/workbench-remote.js",
    "lib/invariant.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/client/**/*.d.ts",
    "lib/types/client/**/*.d.ts.map",
    "lib/types/index.d.ts",
    "lib/types/index.d.ts.map",
    "lib/types/contracts.d.ts",
    "lib/types/contracts.d.ts.map",
    "lib/types/analyzer.d.ts",
    "lib/types/analyzer.d.ts.map",
    "lib/types/evaluation.d.ts",
    "lib/types/evaluation.d.ts.map",
    "lib/types/digest-envelope.d.ts",
    "lib/types/digest-envelope.d.ts.map",
    "lib/types/tools.d.ts",
    "lib/types/tools.d.ts.map",
    "lib/types/control-plane-provider.d.ts",
    "lib/types/control-plane-provider.d.ts.map",
    "lib/types/host-repository-provider.d.ts",
    "lib/types/host-repository-provider.d.ts.map",
    "lib/types/workbench-remote.d.ts",
    "lib/types/workbench-remote.d.ts.map",
    "lib/types/invariant.d.ts",
    "lib/types/invariant.d.ts.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown && node scripts/generate-typert.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "pack:dry-run": "npm --cache .scratch/npm-cache pack --dry-run",
    "pack:smoke": "node scripts/packed-smoke.mjs",
    "pack:browser-e2e": "node scripts/packed-browser-e2e.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "dsh-engineering-control-plane": "^0.1.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dsh-engineering-control-plane": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness-master/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../deepseek-harness-master/packages/core/agent",
    "@deepseek-ai/dsh-api-gateway": "link:../deepseek-harness-master/packages/api/gateway",
    "@deepseek-ai/dsh-client-locale": "link:../deepseek-harness-master/packages/client/locale",
    "@deepseek-ai/dsh-client-runtime": "link:../deepseek-harness-master/packages/client/runtime",
    "@deepseek-ai/dsh-client-test-runtime": "link:../deepseek-harness-master/packages/test-support/client-runtime",
    "@deepseek-ai/dsh-client-ui-layout": "link:../deepseek-harness-master/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../deepseek-harness-master/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../deepseek-harness-master/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../deepseek-harness-master/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "link:../deepseek-harness-master/packages/client/ui-slots",
    "@deepseek-ai/dsh-home-paths": "link:../deepseek-harness-master/packages/util/home-paths",
    "@deepseek-ai/dsh-llm": "link:../deepseek-harness-master/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../deepseek-harness-master/packages/core/session",
    "@deepseek-ai/dsh-system-prompt": "link:../deepseek-harness-master/packages/core/system-prompt",
    "@deepseek-ai/dsh-subagent": "link:../deepseek-harness-master/packages/subagent/subagent",
    "@deepseek-ai/dsh-subprocess-local": "link:../deepseek-harness-master/packages/subprocess/subprocess-local",
    "@deepseek-ai/dsh-tools": "link:../deepseek-harness-master/packages/core/tools",
    "@deepseek-ai/dsh-typert-generator": "link:../deepseek-harness-master/packages/typert/generator",
    "@deepseek-ai/dsh-typert-protocol": "link:../deepseek-harness-master/packages/typert/protocol",
    "@deepseek-ai/dsh-typert-registry": "link:../deepseek-harness-master/packages/typert/registry",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "dsh-engineering-control-plane": "link:../DSH Engineering Control Plane",
    "jsdom": "29.1.1",
    "react": "link:../deepseek-harness-master/packages/test-support/client-runtime/node_modules/react",
    "react-dom": "link:../deepseek-harness-master/packages/test-support/client-runtime/node_modules/react-dom",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
