{
  "name": "dsh-security-assurance",
  "description": "Evidence-backed application-security assurance for DeepSeek Harness",
  "version": "0.1.0-rc.10",
  "private": false,
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/types/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./analyzer": {
      "types": "./lib/types/analyzer.d.ts",
      "default": "./lib/analyzer.js"
    },
    "./conformance": {
      "types": "./lib/types/conformance.d.ts",
      "default": "./lib/conformance.js"
    },
    "./evaluation": {
      "types": "./lib/types/evaluation.d.ts",
      "default": "./lib/evaluation.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./control-plane-provider": {
      "types": "./lib/types/control-plane-provider.d.ts",
      "default": "./lib/control-plane-provider.js"
    },
    "./host-repository-provider": {
      "types": "./lib/types/host-repository-provider.d.ts",
      "default": "./lib/host-repository-provider.js"
    },
    "./workbench-remote": {
      "types": "./lib/types/workbench-remote.d.ts",
      "default": "./lib/workbench-remote.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/*.svg",
    "lib/index.js",
    "lib/contracts.js",
    "lib/analyzer.js",
    "lib/conformance.js",
    "lib/evaluation.js",
    "lib/tools.js",
    "lib/control-plane-provider.js",
    "lib/host-repository-provider.js",
    "lib/workbench-remote.js",
    "lib/invariant.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/types/index.d.ts",
    "lib/types/index.d.ts.map",
    "lib/types/contracts.d.ts",
    "lib/types/contracts.d.ts.map",
    "lib/types/analyzer.d.ts",
    "lib/types/analyzer.d.ts.map",
    "lib/types/conformance.d.ts",
    "lib/types/conformance.d.ts.map",
    "lib/types/evaluation.d.ts",
    "lib/types/evaluation.d.ts.map",
    "lib/types/digest-envelope.d.ts",
    "lib/types/digest-envelope.d.ts.map",
    "lib/types/tools.d.ts",
    "lib/types/tools.d.ts.map",
    "lib/types/control-plane-provider.d.ts",
    "lib/types/control-plane-provider.d.ts.map",
    "lib/types/host-repository-provider.d.ts",
    "lib/types/host-repository-provider.d.ts.map",
    "lib/types/workbench-remote.d.ts",
    "lib/types/workbench-remote.d.ts.map",
    "lib/types/invariant.d.ts",
    "lib/types/invariant.d.ts.map",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown && node scripts/generate-typert.mjs",
    "lint": "oxlint src tests scripts/latest-harness-profile-smoke.mjs scripts/harness-compat-matrix.mjs --deny-warnings",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:dual-plugin-e2e": "vitest run tests/control-plane-provider.spec.ts tests/change-assessment.spec.ts tests/subject-freeze.spec.ts tests/invariant.spec.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "pack:dry-run": "npm --cache .scratch/npm-cache pack --dry-run",
    "pack:profile-smoke": "node scripts/latest-harness-profile-smoke.mjs",
    "release:check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm pack:dry-run && pnpm pack:profile-smoke"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.1 || 0.1.2-alpha.2 || 0.1.2-alpha.3 || 0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-alpha.1 || 0.1.2-alpha.2 || 0.1.2-alpha.3 || 0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.1.2-alpha.1 || 0.1.2-alpha.2 || 0.1.2-alpha.3 || 0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.1 || 0.1.2-alpha.2 || 0.1.2-alpha.3 || 0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.1 || 0.1.2-alpha.2 || 0.1.2-alpha.3 || 0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.1 || 0.1.2-alpha.2 || 0.1.2-alpha.3 || 0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.1 || 0.1.2-alpha.2 || 0.1.2-alpha.3 || 0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.1 || 0.1.2-alpha.2 || 0.1.2-alpha.3 || 0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.1 || 0.1.2-alpha.2 || 0.1.2-alpha.3 || 0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.2-alpha.1 || 0.1.2-alpha.2 || 0.1.2-alpha.3 || 0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1",
    "dsh-engineering-control-plane": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "dsh-engineering-control-plane": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness-latest/vendor/cordis",
    "@deepseek-ai/cordis-plugin-loader": "link:../deepseek-harness-latest/vendor/loader",
    "@deepseek-ai/dsh-agent": "link:../deepseek-harness-latest/packages/core/agent",
    "@deepseek-ai/dsh-commands": "link:../deepseek-harness-latest/packages/interaction/commands",
    "@deepseek-ai/dsh-api-gateway": "link:../deepseek-harness-latest/packages/api/gateway",
    "@deepseek-ai/dsh-home-paths": "link:../deepseek-harness-latest/packages/util/home-paths",
    "@deepseek-ai/dsh-invariants": "link:../deepseek-harness-latest/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "link:../deepseek-harness-latest/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../deepseek-harness-latest/packages/core/session",
    "@deepseek-ai/dsh-system-prompt": "link:../deepseek-harness-latest/packages/core/system-prompt",
    "@deepseek-ai/dsh-subagent": "link:../deepseek-harness-latest/packages/subagent/subagent",
    "@deepseek-ai/dsh-subprocess": "link:../deepseek-harness-latest/packages/subprocess/subprocess",
    "@deepseek-ai/dsh-subprocess-local": "link:../deepseek-harness-latest/packages/subprocess/subprocess-local",
    "@deepseek-ai/dsh-tools": "link:../deepseek-harness-latest/packages/core/tools",
    "@deepseek-ai/dsh-typert-generator": "link:../deepseek-harness-latest/packages/typert/generator",
    "@deepseek-ai/dsh-typert-protocol": "link:../deepseek-harness-latest/packages/typert/protocol",
    "@deepseek-ai/dsh-typert-registry": "link:../deepseek-harness-latest/packages/typert/registry",
    "@types/node": "^22.20.0",
    "dsh-engineering-control-plane": "link:../DSH Engineering Control Plane",
    "oxlint": "link:../deepseek-harness-latest/node_modules/oxlint",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
