{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": ".",
    // The generated Remote declarations name the package's own subpaths; the
    // build config maps them to source through outDir, this config cannot.
    "paths": {
      "dsh-security-assurance/contracts": ["./src/contracts.ts"],
      "dsh-security-assurance/workbench-local": ["./src/workbench-local.ts"],
      "dsh-security-assurance/workbench-remote": ["./src/workbench-remote.ts"],
      // Tests run the Harness gateway client from source; check against its declarations.
      "@deepseek-ai/dsh-api-gateway/src/client/index.ts": [
        "./node_modules/@deepseek-ai/dsh-api-gateway/lib/types/client/index.d.ts"
      ]
    }
  },
  "include": ["src", "tests", "vitest.config.ts", "tsdown.config.ts"],
  "exclude": [
    "tests/workbench-ui.client.spec.tsx"
  ]
}
