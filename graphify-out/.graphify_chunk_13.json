  "nodes": [
    {"id":"docs_adr_0245_contract_imports_are_side_effect_free_and_runtime_entries_start_dormant_decision","label":"Contract Imports Are Side-Effect-Free and Runtime Entries Start Dormant","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0245-contract-imports-are-side-effect-free-and-runtime-entries-start-dormant.md","source_location":"# Contract imports are side-effect-free and runtime entries start dormant","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Package installation and contract imports must not change Host behavior; runtime effects begin only under explicit Cordis activation and end with their Fibers."},
    {"id":"docs_adr_0246_public_dtos_are_versioned_json_safe_and_runtime_validated_decision","label":"Public DTOs Are Versioned, JSON-Safe, and Runtime-Validated","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0246-public-dtos-are-versioned-json-safe-and-runtime-validated.md","source_location":"# Public DTOs are versioned, JSON-safe, and runtime-validated","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Every public boundary uses bounded runtime-validated JSON values and opaque identities rather than internal objects, paths, handles, or rows."},
    {"id":"docs_adr_0247_public_operations_return_one_typed_security_result_envelope_decision","label":"Public Operations Return One Typed Security Result Envelope","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0247-public-operations-return-one-typed-security-result-envelope.md","source_location":"# Public operations return one typed Security Result envelope","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"One discriminated result envelope preserves consistent value and failure semantics across Service callers, tools, and transports."},
    {"id":"docs_adr_0248_commands_return_receipts_and_queries_return_immutable_snapshots_decision","label":"Commands Return Receipts and Queries Return Immutable Snapshots","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0248-commands-return-receipts-and-queries-return-immutable-snapshots.md","source_location":"# Commands return Receipts and queries return immutable Snapshots","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Callers continue through identities and revisions rather than retaining mutable aggregate references or transaction handles."},
    {"id":"docs_adr_0249_repository_administration_is_explicit_versioned_and_non_destructive_decision","label":"Repository Administration Is Explicit, Versioned, and Non-Destructive","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0249-repository-administration-is-explicit-versioned-and-non-destructive.md","source_location":"# Repository Administration is explicit, versioned, and non-destructive","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Registration, update, and disable are separate authorized operations that retain audit history and never implicitly register or hard-delete repositories."},
    {"id":"docs_adr_0250_plugin_config_references_authorities_and_providers_but_contains_no_secrets_decision","label":"Plugin Config References Authorities and Providers but Contains No Secrets","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0250-plugin-config-references-authorities-and-providers-but-contains-no-secrets.md","source_location":"# Plugin config references authorities and Providers but contains no secrets","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Configuration selects trusted identities and bounded defaults while credentials and key material remain behind governed providers and brokers."},
    {"id":"docs_adr_0251_service_health_is_explicit_and_safe_mode_remains_queryable_decision","label":"Service Health Is Explicit and Safe Mode Remains Queryable","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0251-service-health-is-explicit-and-safe-mode-remains-queryable.md","source_location":"# Service health is explicit and safe mode remains queryable","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Integrity or dependency failures close mutation admission while preserving authorized bounded diagnosis and valid sealed-record reads where safe."},
    {"id":"docs_adr_0252_transport_adapters_contain_no_domain_policy_decision","label":"Transport Adapters Contain No Domain Policy","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0252-transport-adapters-contain-no-domain-policy.md","source_location":"# Transport Adapters contain no domain Policy","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Adapters derive trusted channel authority, validate framing, map cancellation, and invoke one Service operation without duplicating policy, storage, verdict, or redaction semantics."},
    {"id":"docs_adr_0253_the_invariant_entry_verifies_composition_without_patching_harness_decision","label":"The Invariant Entry Verifies Composition Without Patching Harness","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0253-the-invariant-entry-verifies-composition-without-patching-harness.md","source_location":"# The invariant entry verifies composition without patching Harness","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The optional dormant entry reports composition checks into health but never patches Harness, repairs state, substitutes providers, or weakens admission."},
    {"id":"docs_adr_0254_the_conformance_module_tests_public_contracts_without_bypasses_decision","label":"The Conformance Module Tests Public Contracts Without Bypasses","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0254-the-conformance-module-tests-public-contracts-without-bypasses.md","source_location":"# The conformance Module tests public contracts without bypasses","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Reusable contract suites and reference fakes exercise public composition without authority minting, Store writers, integrity skips, or a second Kernel."},
    {"id":"docs_adr_0255_v0_1_service_operations_are_fixed_and_explicit_decision","label":"v0.1 Service Operations Are Fixed and Explicit","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0255-v0-1-service-operations-are-fixed-and-explicit.md","source_location":"# v0.1 Service operations are fixed and explicit","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The reviewed operation catalog admits only named typed behaviors and excludes generic execute, query, CRUD, SQL, or arbitrary tool escape hatches."},
    {"id":"docs_adr_0256_public_operations_are_async_results_except_local_analyzer_registration_decision","label":"Public Operations Are Async Results Except Local Analyzer Registration","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0256-public-operations-are-async-results-except-local-analyzer-registration.md","source_location":"# Public operations are async Results except local Analyzer registration","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Runtime operations share one asynchronous result contract; synchronous analyzer registration is limited to structural Host composition and fails activation loudly."},
    {"id":"docs_adr_0257_invocation_request_and_local_execution_options_are_separate_decision","label":"Invocation, Request, and Local Execution Options Are Separate","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0257-invocation-request-and-local-execution-options-are-separate.md","source_location":"# Invocation, Request, and local execution options are separate","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Opaque authority, JSON-safe semantics, and process-local cancellation or deadlines remain separate so requests cannot smuggle permissions or capabilities."},
    {"id":"docs_adr_0258_analyzer_registration_is_local_composition_and_effect_owned_decision","label":"Analyzer Registration Is Local Composition and Effect-Owned","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0258-analyzer-registration-is-local-composition-and-effect-owned.md","source_location":"# Analyzer registration is local composition and effect-owned","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Analyzer registration exists only in-process, validates structure synchronously, and returns a contributor-owned disposer; it is absent from remote and model surfaces."},
    {"id":"docs_adr_0259_security_catalog_reports_effective_capability_without_exposing_registries_decision","label":"Security Catalog Reports Effective Capability Without Exposing Registries","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0259-security-catalog-reports-effective-capability-without-exposing-registries.md","source_location":"# Security Catalog reports effective capability without exposing Registries","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Authority-filtered capability summaries derive from qualified composition and cannot expose factories, credentials, backends, raw registries, or claims beyond the Support Matrix."},
    {"id":"docs_adr_0260_repository_admin_dtos_bind_host_resolved_security_configuration_decision","label":"Repository Admin DTOs Bind Host-Resolved Security Configuration","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0260-repository-admin-dtos-bind-host-resolved-security-configuration.md","source_location":"# Repository admin DTOs bind Host-resolved security configuration","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Administrative requests bind canonical roots and named security configuration while excluding scripts, credentials, raw providers, arbitrary analyzers, and repository-authored authority."},
    {"id":"docs_adr_0261_repository_mutations_use_revision_cas_and_idempotency_decision","label":"Repository Mutations Use Revision CAS and Idempotency","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0261-repository-mutations-use-revision-cas-and-idempotency.md","source_location":"# Repository mutations use revision CAS and idempotency","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Idempotent registration and exact expected-revision comparison prevent duplicate or stale repository mutations while preserving frozen assessment bindings."},
    {"id":"docs_adr_0262_start_requests_carry_references_selectors_and_stronger_controls_only_decision","label":"Start Requests Carry References, Selectors, and Stronger Controls Only","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0262-start-requests-carry-references-selectors-and-stronger-controls-only.md","source_location":"# Start requests carry references, selectors, and stronger controls only","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Callers select bounded references and stronger controls while the Service resolves all effective semantic inputs from Host-owned versioned configuration."},
    {"id":"docs_adr_0263_target_selectors_use_mode_specific_discriminated_schemas_decision","label":"Target Selectors Use Mode-Specific Discriminated Schemas","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0263-target-selectors-use-mode-specific-discriminated-schemas.md","source_location":"# Target Selectors use Mode-specific discriminated schemas","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Closed canonical Repository, Change, and Targeted variants prevent free-form or root-escaping targets and bind selection into Subject and Coverage identity."},
    {"id":"docs_adr_0264_assessment_creation_commits_only_after_subject_freeze_succeeds_decision","label":"Assessment Creation Commits Only After Subject Freeze Succeeds","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0264-assessment-creation-commits-only-after-subject-freeze-succeeds.md","source_location":"# Assessment creation commits only after Subject Freeze succeeds","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"No Assessment identity or authoritative work commits until stable read, immutable snapshot materialization, manifest verification, and atomic Subject Freeze succeed."},
