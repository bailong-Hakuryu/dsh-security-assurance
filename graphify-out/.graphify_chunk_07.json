{
  "nodes": [
    {"id":"docs_adr_0122_only_coverage_reconciliation_can_seal_indeterminate_decision","label":"Only Coverage Reconciliation Can Seal INDETERMINATE","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0122-only-coverage-reconciliation-can-seal-indeterminate.md","source_location":"# Only Coverage Reconciliation can seal INDETERMINATE","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Recoverable failures remain BLOCKED; deterministic reconciliation may seal indeterminate only after proving no eligible path remains or the frozen budget is exhausted."},
    {"id":"docs_adr_0123_cancellation_commits_only_after_proven_quiescence_decision","label":"Cancellation Commits Only After Proven Quiescence","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0123-cancellation-commits-only-after-proven-quiescence.md","source_location":"# Cancellation commits only after proven quiescence","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"CANCELED is truthful only after all assessment-owned work is durably unable to publish or mutate state."},
    {"id":"docs_adr_0124_resume_preserves_the_frozen_assessment_contract_decision","label":"Resume Preserves the Frozen Assessment Contract","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0124-resume-preserves-the-frozen-assessment-contract.md","source_location":"# Resume preserves the frozen Assessment contract","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Resume may create attempts only for incomplete eligible work under the original subject, policy, plan, composition, and budget; semantic changes require a new Assessment."},
    {"id":"docs_adr_0125_risk_acceptance_occurs_before_seal_in_a_decision_window_decision","label":"Risk Acceptance Occurs Before Seal in a Decision Window","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0125-risk-acceptance-occurs-before-seal-in-a-decision-window.md","source_location":"# Risk Acceptance occurs before Seal in a decision window","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Risk decisions are permitted only in an explicit pre-seal BLOCKED window and can never rewrite a sealed historical assessment."},
    {"id":"docs_adr_0126_risk_acceptance_requires_human_or_control_plane_decision_authority_decision","label":"Risk Acceptance Requires Human or Control Plane Decision Authority","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0126-risk-acceptance-requires-human-or-control-plane-decision-authority.md","source_location":"# Risk Acceptance requires human or Control Plane Decision Authority","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Models, role agents, analyzers, and ordinary callers cannot accept risk; critical break-glass requires two distinct qualified human authorities."},
    {"id":"docs_adr_0127_official_exports_require_a_sealed_assessment_decision","label":"Official Exports Require a SEALED Assessment","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0127-official-exports-require-a-sealed-assessment.md","source_location":"# Official exports require a SEALED Assessment","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Only sealed assessments may produce canonical bundles, official exports, or Control Plane submissions; diagnostic views remain non-authoritative."},
    {"id":"docs_adr_0128_seal_verdict_bundle_and_submission_commit_atomically_decision","label":"Seal, Verdict, Bundle, and Submission Commit Atomically","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0128-seal-verdict-bundle-and-submission-commit-atomically.md","source_location":"# Seal, Verdict, Bundle, and Submission commit atomically","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A SEALED state exists only when verified immutable artifacts and their exact digests commit with Seal, Verdict, Bundle Manifest, Submission identity, and final revision."},
    {"id":"docs_adr_0129_model_tools_expose_explicit_assessment_operations_without_risk_acceptance_decision","label":"Model Tools Expose Explicit Assessment Operations Without Risk Acceptance","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0129-model-tools-expose-explicit-assessment-operations-without-risk-acceptance.md","source_location":"# Model tools expose explicit Assessment operations without Risk Acceptance","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Separate bounded tools delegate to the Security Service; there is no generic command, repository administration, or model Risk Acceptance tool."},
    {"id":"docs_adr_0130_model_results_are_bounded_and_redacted_by_default_decision","label":"Model Results Are Bounded and Redacted by Default","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0130-model-results-are-bounded-and-redacted-by-default.md","source_location":"# Model results are bounded and redacted by default","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Service-enforced pagination, size limits, and redaction prevent sensitive evidence and protected source from entering model history by default."},
    {"id":"docs_adr_0131_third_party_analyzers_register_through_the_security_service_decision","label":"Third-Party Analyzers Register Through the Security Service","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0131-third-party-analyzers-register-through-the-security-service.md","source_location":"# Third-party analyzers register through the Security Service","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Validated fiber-owned registration freezes exact analyzer identity and capability while rejecting duplicate or contradictory descriptors before execution."},
    {"id":"docs_adr_0132_config_replacement_quiesces_before_recovery_decision","label":"Config Replacement Quiesces Before Recovery","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0132-config-replacement-quiesces-before-recovery.md","source_location":"# Config replacement quiesces before recovery","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The old Service closes admission and records interruptions before unload; replacement recovers durably without silently migrating or resuming frozen assessments."},
    {"id":"docs_adr_0133_assessment_aggregate_has_a_narrow_consistency_boundary_decision","label":"Assessment Aggregate Has a Narrow Consistency Boundary","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0133-assessment-aggregate-has-a-narrow-consistency-boundary.md","source_location":"# Assessment Aggregate has a narrow consistency boundary","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Lifecycle, attempts, findings, coverage, decisions, verdict, and seal share one aggregate, while repositories, evidence payloads, remediation, and delivery remain separate identity-bound boundaries."},
    {"id":"docs_adr_0134_persistence_combines_a_revision_journal_with_current_projections_decision","label":"Persistence Combines a Revision Journal with Current Projections","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0134-persistence-combines-a-revision-journal-with-current-projections.md","source_location":"# Persistence combines a Revision Journal with current projections","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Each mutation appends immutable provenance and updates its bounded read projection in the same SQLite transaction so they cannot disagree."},
    {"id":"docs_adr_0135_commands_publish_durable_work_transactionally_decision","label":"Commands Publish Durable Work Transactionally","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0135-commands-publish-durable-work-transactionally.md","source_location":"# Commands publish durable work transactionally","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Command outcome, revision, and outbox work commit together so crashes create neither orphan state nor lost in-memory callbacks."},
    {"id":"docs_adr_0136_revisions_advance_once_per_externally_observable_transaction_decision","label":"Revisions Advance Once per Externally Observable Transaction","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0136-revisions-advance-once-per-externally-observable-transaction.md","source_location":"# Revisions advance once per externally observable transaction","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Revision measures committed domain change rather than row-write volume and supports optimistic concurrency and long polling."},
    {"id":"docs_adr_0137_idempotency_binds_authority_operation_target_and_request_decision","label":"Idempotency Binds Authority, Operation, Target, and Request","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0137-idempotency-binds-authority-operation-target-and-request.md","source_location":"# Idempotency binds authority operation target and request","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A repeated equivalent mutation returns its original outcome, while key reuse under different effective content fails closed without mutation."},
    {"id":"docs_adr_0138_state_transitions_are_exhaustive_and_declarative_decision","label":"State Transitions Are Exhaustive and Declarative","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0138-state-transitions-are-exhaustive-and-declarative.md","source_location":"# State transitions are exhaustive and declarative","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"One Kernel-owned matrix defines every legal transition and rejection, preventing Service methods from inventing independent lifecycle semantics."},
    {"id":"docs_adr_0139_execution_may_repeat_but_result_admission_is_at_most_once_decision","label":"Execution May Repeat but Result Admission Is at Most Once","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0139-execution-may-repeat-but-result-admission-is-at-most-once.md","source_location":"# Execution may repeat but result admission is at most once","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Physical analyzer execution may repeat after failure, but fenced idempotent compare-and-swap admits each terminal result no more than once."},
    {"id":"docs_adr_0140_evidence_enters_through_staged_verified_publication_decision","label":"Evidence Enters Through Staged Verified Publication","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0140-evidence-enters-through-staged-verified-publication.md","source_location":"# Evidence enters through staged verified publication","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Untrusted producers receive bounded staging only; the Service validates and protects bytes before atomically publishing an immutable evidence identity and digest."},
    {"id":"docs_adr_0141_digests_use_versioned_deterministic_envelopes_decision","label":"Digests Use Versioned Deterministic Envelopes","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0141-digests-use-versioned-deterministic-envelopes.md","source_location":"# Digests use versioned deterministic envelopes","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Versioned algorithm, media, length, and canonicalization metadata make content identities deterministic without reinterpreting older digests."},
    {"id":"docs_adr_0142_sqlite_migrations_are_monotonic_verified_and_fail_closed_decision","label":"SQLite Migrations Are Monotonic, Verified, and Fail Closed","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0142-sqlite-migrations-are-monotonic-verified-and-fail-closed.md","source_location":"# SQLite migrations are monotonic verified and fail closed","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Forward-only leased migrations with verified backup and integrity checks enter read-only safe mode on failure or an unknown newer schema."},
