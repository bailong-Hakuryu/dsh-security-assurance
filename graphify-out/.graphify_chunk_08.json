  "nodes": [
    {"id":"docs_adr_0143_crash_recovery_never_silently_resumes_assessment_work_crash_recovery_never_silently_resumes_assessment_work","label":"Crash recovery never silently resumes Assessment work","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0143-crash-recovery-never-silently-resumes-assessment-work.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Recovery may repair deterministic storage state and mark attempts interrupted, but semantic work resumes only through an authorized operation under the frozen contract."},
    {"id":"docs_adr_0144_execution_lease_takeover_requires_expiry_and_stronger_fencing_execution_lease_takeover_requires_expiry_and_stronger_fencing","label":"Execution Lease takeover requires expiry and stronger fencing","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0144-execution-lease-takeover-requires-expiry-and-stronger-fencing.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Lease takeover requires verified expiry and a strictly greater fencing token so delayed former holders can never mutate current state."},
    {"id":"docs_adr_0145_pagination_cursors_bind_query_authority_and_watermark_pagination_cursors_bind_query_authority_and_watermark","label":"Pagination cursors bind query authority and watermark","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0145-pagination-cursors-bind-query-authority-and-watermark.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Opaque keyset cursors bind normalized query, disclosure authority, scope, order, size ceiling, and consistency watermark and invalidate when any binding changes."},
    {"id":"docs_adr_0146_wait_for_revision_is_bounded_cancellable_and_transaction_free_wait_for_revision_is_bounded_cancellable_and_transaction_free","label":"Wait for revision is bounded cancellable and transaction-free","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0146-wait-for-revision-is-bounded-cancellable-and-transaction-free.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Revision waiting is bounded, cancellable, rate limited, repeatable from the returned revision, and holds no transaction, lock, lease, or privileged store object."},
    {"id":"docs_adr_0147_public_errors_are_stable_typed_and_redacted_public_errors_are_stable_typed_and_redacted","label":"Public errors are stable typed and redacted","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0147-public-errors-are-stable-typed-and-redacted.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Public failures use a versioned stable envelope while sensitive paths, evidence, secrets, payloads, traces, and unauthorized-resource existence remain private."},
    {"id":"docs_adr_0148_analyzer_identity_binds_version_schema_and_build_analyzer_identity_binds_version_schema_and_build","label":"Analyzer identity binds version schema and build","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0148-analyzer-identity-binds-version-schema-and-build.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Stable analyzer identity combines namespaced ID, implementation version, descriptor schema version, and integrity-bound build digest across registration, attempts, lineage, qualification, and seals."},
    {"id":"docs_adr_0149_analyzer_descriptors_are_frozen_validated_pure_data_analyzer_descriptors_are_frozen_validated_pure_data","label":"Analyzer Descriptors are frozen validated pure data","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0149-analyzer-descriptors-are-frozen-validated-pure-data.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Admission uses a deeply frozen JSON-safe validated descriptor containing only declarative claims; executable construction remains in a separate factory."},
    {"id":"docs_adr_0150_analyzer_capabilities_use_a_versioned_taxonomy_analyzer_capabilities_use_a_versioned_taxonomy","label":"Analyzer capabilities use a versioned taxonomy","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0150-analyzer-capabilities-use-a-versioned-taxonomy.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Capability claims use a versioned core vocabulary; unknown mandatory meanings fail composition while optional extensions remain non-authoritative metadata."},
    {"id":"docs_adr_0151_the_kernel_computes_and_freezes_verdict_eligibility_the_kernel_computes_and_freezes_verdict_eligibility","label":"The Kernel computes and freezes Verdict Eligibility","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0151-the-kernel-computes-and-freezes-verdict-eligibility.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The kernel computes immutable eligibility from validated identity, qualification, provider, probe, policy, contracts, boundary, and runtime conditions; analyzers cannot self-declare eligibility."},
    {"id":"docs_adr_0152_analyzer_instances_are_attempt_scoped_and_disposable_analyzer_instances_are_attempt_scoped_and_disposable","label":"Analyzer instances are Attempt-scoped and disposable","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0152-analyzer-instances-are-attempt-scoped-and-disposable.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Each durable attempt owns a fresh analyzer instance and every resource it obtains; every terminal or recovery path requires disposal or durable proof that quiescence is unknown."},
    {"id":"docs_adr_0153_analyzer_inputs_are_immutable_bounded_and_authority_free_analyzer_inputs_are_immutable_bounded_and_authority_free","label":"Analyzer inputs are immutable bounded and authority-free","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0153-analyzer-inputs-are-immutable-bounded-and-authority-free.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"AnalyzerInput freezes semantic task data without ambient host authority; executable access is separately supplied through execution-class capability handles."},
    {"id":"docs_adr_0154_analyzer_contributions_are_versioned_and_cannot_decide_verdicts_analyzer_contributions_are_versioned_and_cannot_decide_verdicts","label":"Analyzer Contributions are versioned and cannot decide Verdicts","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0154-analyzer-contributions-are-versioned-and-cannot-decide-verdicts.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A bounded versioned contribution is validated before admission and reconciled by the kernel; it cannot mutate state, grant acceptance, decide verdicts, seal, submit, or trigger arbitrary work."},
    {"id":"docs_adr_0155_runner_progress_events_are_bounded_and_non_authoritative_runner_progress_events_are_bounded_and_non_authoritative","label":"Runner progress events are bounded and non-authoritative","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0155-runner-progress-events-are-bounded-and-non-authoritative.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Rate- and size-limited events report progress but cannot affect findings, coverage, budget, or authoritative state; only the terminal contribution is semantic output."},
    {"id":"docs_adr_0156_attempt_cancellation_fences_late_results_and_requires_cleanup_attempt_cancellation_fences_late_results_and_requires_cleanup","label":"Attempt cancellation fences late results and requires cleanup","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0156-attempt-cancellation-fences-late-results-and-requires-cleanup.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Cancellation durably closes admission before signaling abort, rejects stale results, and requires bounded backend termination plus disposal evidence or blocks the assessment."},
    {"id":"docs_adr_0157_the_kernel_reserves_and_meters_nested_attempt_budgets_the_kernel_reserves_and_meters_nested_attempt_budgets","label":"The Kernel reserves and meters nested Attempt budgets","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0157-the-kernel-reserves-and-meters-nested-attempt-budgets.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The kernel reserves maximum attempt budget before execution and service-owned handles meter all nested work against that authority until settlement."},
    {"id":"docs_adr_0158_scheduling_enforces_hierarchical_fair_concurrency_scheduling_enforces_hierarchical_fair_concurrency","label":"Scheduling enforces hierarchical fair concurrency","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0158-scheduling-enforces-hierarchical-fair-concurrency.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The service scheduler is the only admission path and applies a frozen hierarchical concurrency envelope with bounded fair queues."},
    {"id":"docs_adr_0159_in_process_extensions_are_trusted_host_code_not_a_sandbox_in_process_extensions_are_trusted_host_code_not_a_sandbox","label":"In-process extensions are trusted Host code not a sandbox","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0159-in-process-extensions-are-trusted-host-code-not-a-sandbox.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"In-process JavaScript has ambient host authority; descriptors and handles govern integration but do not create a sandbox, so untrusted code requires a qualified isolation backend."},
    {"id":"docs_adr_0160_analyzers_receive_only_attempt_scoped_capability_handles_analyzers_receive_only_attempt_scoped_capability_handles","label":"Analyzers receive only Attempt-scoped Capability Handles","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0160-analyzers-receive-only-attempt-scoped-capability-handles.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Opaque minimum-privilege handles bind execution authority to attempt identity, budget, deadline, and fence and reject use after settlement or transfer."},
    {"id":"docs_adr_0161_external_network_access_passes_through_governed_brokers_external_network_access_passes_through_governed_brokers","label":"External network access passes through governed brokers","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0161-external-network-access-passes-through-governed-brokers.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Gate-bearing analyzers have no ambient network path and may reach external services only through qualified, quota-bound, audited egress brokers under frozen contracts."},
    {"id":"docs_adr_0162_authoritative_contributions_are_not_reused_across_assessments_in_v0_1_authoritative_contributions_are_not_reused_across_assessments_in_v0_1","label":"Authoritative Contributions are not reused across Assessments in v0.1","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0162-authoritative-contributions-are-not-reused-across-assessments-in-v0-1.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Every gate-bearing assessment executes and admits a fresh contribution with new lineage and budget; non-authoritative parse cache affects performance only."},
    {"id":"docs_adr_0163_gate_bearing_analyzers_require_scoped_qualification_records_gate_bearing_analyzers_require_scoped_qualification_records","label":"Gate-bearing Analyzers require scoped Qualification Records","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0163-gate-bearing-analyzers-require-scoped-qualification-records.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Gate-bearing status requires a current host-trusted qualification record for the exact analyzer identity and build across capability, isolation, evidence, failure, effectiveness, provider, platform, and scope constraints."},
