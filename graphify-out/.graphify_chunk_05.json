    {"id":"docs_adr_0082_public_security_claims_are_evidence_and_scope_bound_public_security_claims_are_evidence_and_scope_bound","label":"Public security claims are Evidence- and scope-bound","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0082-public-security-claims-are-evidence-and-scope-bound.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Every public support claim must name its ecosystem, mode, profile, policy, matrix, evaluation versions, providers, metrics, costs, uncertainty, and omissions."},
    {"id":"docs_adr_0083_the_security_product_has_a_stricter_self_security_release_gate_the_security_product_has_a_stricter_self_security_release_gate","label":"The security product has a stricter self-security Release Gate","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0083-the-security-product-has-a-stricter-self-security-release-gate.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Release requires zero confirmed critical or high self-findings, and medium findings affecting foundational assurance properties block by default."},
    {"id":"docs_adr_0084_stable_support_requires_windows_linux_and_macos_proof_stable_support_requires_windows_linux_and_macos_proof","label":"Stable support requires Windows, Linux, and macOS proof","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0084-stable-support-requires-windows-linux-and-macos-proof.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Stable 0.1.0 core capability requires packed-install and conformance evidence on all three supported desktop platforms."},
    {"id":"docs_adr_0085_security_telemetry_is_off_by_default_and_aggregate_only_security_telemetry_is_off_by_default_and_aggregate_only","label":"Security Telemetry is off by default and aggregate only","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0085-security-telemetry-is-off-by-default-and-aggregate-only.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Telemetry requires opt-in, contains only versioned aggregate operations data, and excludes source, paths, findings, evidence, credentials, ground truth, and other sensitive content."},
    {"id":"docs_adr_0086_public_scorecards_prove_method_without_exposing_holdouts_public_scorecards_prove_method_without_exposing_holdouts","label":"Public Scorecards prove method without exposing Holdouts","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0086-public-scorecards-prove-method-without-exposing-holdouts.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A redacted scorecard exposes enough method, metrics, uncertainty, budgets, limits, and failures to assess evidence strength without disclosing holdout answers or sensitive evidence."},
    {"id":"docs_adr_0087_stable_promotion_uses_the_exact_qualified_build_stable_promotion_uses_the_exact_qualified_build","label":"Stable promotion uses the exact qualified build","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0087-stable-promotion-uses-the-exact-qualified-build.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Stable promotion preserves qualified behavior byte-for-byte except for version, signature, and release metadata; behavioral changes require a new RC and rerun gates."},
    {"id":"docs_adr_0088_security_assurance_ships_as_one_bundle_with_independent_entry_points_security_assurance_ships_as_one_bundle_with_independent_entry_points","label":"Security Assurance ships as one bundle with independent entry points","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0088-security-assurance-ships-as-one-bundle-with-independent-entry-points.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"One npm and plugin product exposes independently activatable service, tool, provider, workbench, invariant, and generated-contract entry points until real deployment pressure justifies package splits."},
    {"id":"docs_adr_0089_public_names_identify_security_assurance_public_names_identify_security_assurance","label":"Public names identify Security Assurance","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0089-public-names-identify-security-assurance.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The package, Cordis capability, and Remote namespace use Security Assurance-specific names to preserve the product's independent authority boundary."},
    {"id":"docs_adr_0090_installed_security_entry_points_are_dormant_by_default_installed_security_entry_points_are_dormant_by_default","label":"Installed Security entry points are dormant by default","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0090-installed-security-entry-points-are-dormant-by-default.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Installation contributes dormant capability rows; a deployment owner enables them only after all policy, protection, execution, budget, mapping, and integration configuration is complete."},
    {"id":"docs_adr_0091_one_security_service_exposes_explicit_domain_operations_one_security_service_exposes_explicit_domain_operations","label":"One Security Service exposes explicit domain operations","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0091-one-security-service-exposes-explicit-domain-operations.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A single public strongly typed service exposes explicit Assessment, Remediation, and Delivery commands and queries while their deep modules remain separate behind it."},
    {"id":"docs_adr_0092_assessment_start_publishes_a_durable_receipt_assessment_start_publishes_a_durable_receipt","label":"Assessment start publishes a durable receipt","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0092-assessment-start-publishes-a-durable-receipt.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"startAssessment returns only after durable creation commits; after receipt publication the engine owns execution and later lifecycle changes use explicit operations."},
    {"id":"docs_adr_0093_security_mutations_use_branded_identities_revisions_and_idempotency_security_mutations_use_branded_identities_revisions_and_idempotency","label":"Security mutations use branded identities revisions and idempotency","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0093-security-mutations-use-branded-identities-revisions-and-idempotency.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"State-changing commands carry opaque identities, idempotency keys, and expected revisions so duplicates return committed outcomes and stale writes fail without mutation."},
    {"id":"docs_adr_0094_interrupted_analyzer_attempts_require_explicit_resume_interrupted_analyzer_attempts_require_explicit_resume","label":"Interrupted Analyzer attempts require explicit resume","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0094-interrupted-analyzer-attempts-require-explicit-resume.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Recovery never silently re-executes an analyzer attempt; an interrupted attempt blocks the assessment until authorized resume creates a new budgeted attempt with distinct provenance."},
    {"id":"docs_adr_0095_frozen_provider_composition_survives_hot_replacement_frozen_provider_composition_survives_hot_replacement","label":"Frozen Provider Composition survives hot replacement","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0095-frozen-provider-composition-survives-hot-replacement.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Accepted assessments own their exact provider and analyzer handles; hot replacement affects new admission only, and plugin unloading waits for owned work to quiesce."},
    {"id":"docs_adr_0096_security_role_agents_are_orchestrated_directly_through_subagents_security_role_agents_are_orchestrated_directly_through_subagents","label":"Security Role Agents are orchestrated directly through Subagents","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0096-security-role-agents-are-orchestrated-directly-through-subagents.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The durable Assessment Engine invokes ctx.subagents with frozen prompts, restrictions, schemas, provider selection, and budgets and records every admitted and settled contribution."},
    {"id":"docs_adr_0097_workbench_uses_package_owned_typert_remotes_workbench_uses_package_owned_typert_remotes","label":"Workbench uses package-owned Typert remotes","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0097-workbench-uses-package-owned-typert-remotes.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Generated package-owned Typert and Remote contracts let Workbench invoke explicit service operations without central API changes, ad hoc REST, or browser access to storage and evidence paths."},
    {"id":"docs_adr_0098_workbench_is_an_additive_harness_web_surface_workbench_is_an_additive_harness_web_surface","label":"Workbench is an additive Harness Web surface","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0098-workbench-is-an-additive-harness-web-surface.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Workbench contributes through launcher and overlay slots without replacing Harness UI owners, while the host service remains usable without client slots."},
    {"id":"docs_adr_0099_workbench_progress_is_revision_driven_long_polling_workbench_progress_is_revision_driven_long_polling","label":"Workbench progress is revision-driven long polling","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0099-workbench-progress-is-revision-driven-long-polling.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A bounded cancellable Typert wait-for-revision operation drives immutable snapshot refresh and safe reconnect without a plugin-specific SSE or WebSocket protocol."},
    {"id":"docs_adr_0100_security_assurance_plugin_boundary_security_assurance_plugin_boundary","label":"Security Assurance Plugin Boundary","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0100-security-assurance-plugin-boundary.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The independent plugin integrates only through public Harness seams and neither modifies Harness Core nor patches agent-loop, forks Harness, or copies Harness source."},
