{
  "nodes": [
    {"id":"docs_adr_0059_benchmarks_use_four_complementary_corpus_lanes_decision","label":"Benchmarks Use Four Complementary Corpus Lanes","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0059-benchmarks-use-four-complementary-corpus-lanes.md","source_location":"# Benchmarks use four complementary Corpus Lanes","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Complementary deterministic, seeded, historical-pair, and negative-control lanes provide stronger truth than findings from random repositories."},
    {"id":"docs_adr_0060_effectiveness_compares_fixed_baseline_and_product_arms_decision","label":"Effectiveness Compares Fixed Baseline and Product Arms","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0060-effectiveness-compares-fixed-baseline-and-product-arms.md","source_location":"# Effectiveness compares fixed baseline and product Arms","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Fixed comparison arms and matched-budget views expose both security performance and the additional compute used to obtain it."},
    {"id":"docs_adr_0061_effectiveness_prioritizes_validated_risk_and_honest_indeterminacy_decision","label":"Effectiveness Prioritizes Validated Risk and Honest Indeterminacy","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0061-effectiveness-prioritizes-validated-risk-and-honest-indeterminacy.md","source_location":"# Effectiveness prioritizes validated risk and honest indeterminacy","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Validated recall, precision, unsafe satisfaction, and coverage honesty measure safety better than finding volume or model confidence."},
    {"id":"docs_adr_0062_utility_measures_risk_reduction_against_human_and_runtime_cost_decision","label":"Utility Measures Risk Reduction Against Human and Runtime Cost","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0062-utility-measures-risk-reduction-against-human-and-runtime-cost.md","source_location":"# Utility measures risk reduction against human and runtime cost","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Utility must connect validated risk reduction and remediation outcomes to elapsed time, runtime cost, and human effort."},
    {"id":"docs_adr_0063_stochastic_evaluation_reports_distributions_not_best_runs_decision","label":"Stochastic Evaluation Reports Distributions, Not Best Runs","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0063-stochastic-evaluation-reports-distributions-not-best-runs.md","source_location":"# Stochastic evaluation reports distributions, not best runs","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Frozen independent repetitions and distribution statistics prevent cherry-picking favorable stochastic runs."},
    {"id":"docs_adr_0064_ground_truth_leakage_invalidates_the_evaluation_run_decision","label":"Ground Truth Leakage Invalidates the Evaluation Run","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0064-ground-truth-leakage-invalidates-the-evaluation-run.md","source_location":"# Ground Truth leakage invalidates the Evaluation Run","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Any leakage of hidden defects, seed identity, or expected findings contaminates the entire run and cannot be repaired by selective result removal."},
    {"id":"docs_adr_0065_capability_conformance_is_a_reusable_provider_contract_kit_decision","label":"Capability Conformance Is a Reusable Provider Contract Kit","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0065-capability-conformance-is-a-reusable-provider-contract-kit.md","source_location":"# Capability Conformance is a reusable Provider contract kit","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Built-in and third-party providers must prove the same applicable command, state, evidence, recovery, authority, and packaging contracts."},
    {"id":"docs_adr_0066_hostile_repositories_are_first_class_conformance_subjects_decision","label":"Hostile Repositories Are First-Class Conformance Subjects","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0066-hostile-repositories-are-first-class-conformance-subjects.md","source_location":"# Hostile repositories are first-class Conformance Subjects","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Repository-controlled content must be tested as hostile data that can attempt injection, path escape, forgery, policy weakening, or resource exhaustion."},
    {"id":"docs_adr_0067_evaluation_runs_are_immutable_and_pre_registered_decision","label":"Evaluation Runs Are Immutable and Pre-Registered","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0067-evaluation-runs-are-immutable-and-pre-registered.md","source_location":"# Evaluation Runs are immutable and pre-registered","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Immutable run bundles and pre-frozen definitions prevent post-hoc changes that would make an experiment appear to pass."},
    {"id":"docs_adr_0068_development_qualification_and_release_corpora_are_separated_decision","label":"Development, Qualification, and Release Corpora Are Separated","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0068-development-qualification-and-release-corpora-are-separated.md","source_location":"# Development, Qualification, and Release Corpora are separated","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Tuning, milestone qualification, and release promotion require distinct corpus partitions so exposed evidence cannot prove generalization."},
    {"id":"docs_adr_0069_ground_truth_adjudication_is_blinded_and_independent_decision","label":"Ground Truth Adjudication Is Blinded and Independent","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0069-ground-truth-adjudication-is-blinded-and-independent.md","source_location":"# Ground Truth adjudication is blinded and independent","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Independent blinded review with preserved disagreement and tie-break evidence prevents arm identity from biasing finding matches."},
    {"id":"docs_adr_0070_finding_matching_is_predeclared_and_one_to_one_decision","label":"Finding Matching Is Predeclared and One-to-One","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0070-finding-matching-is-predeclared-and-one-to-one.md","source_location":"# Finding matching is predeclared and one-to-one","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Predeclared semantic matching and one-to-one assignment prevent duplicate findings or post-hoc judgment from inflating recall."},
    {"id":"docs_adr_0071_insufficient_benchmark_strata_are_inconclusive_decision","label":"Insufficient Benchmark Strata Are Inconclusive","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0071-insufficient-benchmark-strata-are-inconclusive.md","source_location":"# Insufficient Benchmark strata are inconclusive","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Each severity, weakness, mode, and ecosystem stratum must independently satisfy sample and uncertainty requirements."},
    {"id":"docs_adr_0072_proof_runs_in_pr_nightly_weekly_and_rc_tiers_decision","label":"Proof Runs in PR, Nightly, Weekly, and RC Tiers","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0072-proof-runs-in-pr-nightly-weekly-and-rc-tiers.md","source_location":"# Proof runs in PR, Nightly, Weekly, and RC tiers","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Progressively broader proof tiers culminate in sealed holdout, all-arm, packed-installation, and blinded-adjudication evidence for release candidates."},
    {"id":"docs_adr_0073_model_and_provider_drift_requires_requalification_decision","label":"Model and Provider Drift Requires Requalification","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0073-model-and-provider-drift-requires-requalification.md","source_location":"# Model and Provider drift requires requalification","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Effectiveness evidence binds exact deployment and composition; any drift changes the evaluated arm and requires fresh qualification."},
    {"id":"docs_adr_0074_benchmark_failures_and_reruns_are_preclassified_decision","label":"Benchmark Failures and Reruns Are Preclassified","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0074-benchmark-failures-and-reruns-are-preclassified.md","source_location":"# Benchmark failures and reruns are preclassified","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Product failures count against their arm, while proven benchmark failures invalidate the case uniformly; selective reruns and reclassification are forbidden."},
    {"id":"docs_adr_0075_benchmark_major_changes_require_bridge_runs_decision","label":"Benchmark Major Changes Require Bridge Runs","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0075-benchmark-major-changes-require-bridge-runs.md","source_location":"# Benchmark major changes require Bridge Runs","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Breaking measurement changes require controlled overlap before historical and current results may be compared."},
    {"id":"docs_adr_0076_evaluation_budgets_include_compute_network_and_human_cost_decision","label":"Evaluation Budgets Include Compute, Network, and Human Cost","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0076-evaluation-budgets-include-compute-network-and-human-cost.md","source_location":"# Evaluation Budgets include compute, network, and human cost","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Every arm must freeze and report resource and human limits so quality and efficiency can be compared honestly."},
    {"id":"docs_adr_0077_dogfood_can_block_release_but_cannot_prove_effectiveness_decision","label":"Dogfood Can Block Release but Cannot Prove Effectiveness","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0077-dogfood-can-block-release-but-cannot-prove-effectiveness.md","source_location":"# Dogfood can block release but cannot prove Effectiveness","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Operational findings may expose release-blocking defects, but unknown ground truth prevents dogfood from replacing hidden-corpus effectiveness proof."},
    {"id":"docs_adr_0078_release_thresholds_combine_hard_floors_and_pre_holdout_calibration_decision","label":"Release Thresholds Combine Hard Floors and Pre-Holdout Calibration","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0078-release-thresholds-combine-hard-floors-and-pre-holdout-calibration.md","source_location":"# Release Thresholds combine hard floors and pre-Holdout calibration","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Non-negotiable safety floors and pre-holdout calibrated statistical thresholds prevent unsafe or post-hoc release promotion."},
    {"id":"docs_adr_0079_exposed_release_holdouts_are_retired_after_a_failed_candidate_decision","label":"Exposed Release Holdouts Are Retired After a Failed Candidate","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0079-exposed-release-holdouts-are-retired-after-a-failed-candidate.md","source_location":"# Exposed Release Holdouts are retired after a failed Candidate","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A candidate changed after holdout exposure must use a fresh hidden partition; repeated attempts on the same answers cannot prove generalization."},
