    {"id":"docs_adr_0205_plan_amendments_only_add_or_strengthen_obligations_plan_amendments_only_add_or_strengthen_obligations","label":"Plan Amendments only add or strengthen obligations","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0205-plan-amendments-only-add-or-strengthen-obligations.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Post-compilation discoveries may append or strengthen obligations with full evidence and digest lineage, but never delete, weaken, complete, reinterpret, or silently reorder mandatory work."},
    {"id":"docs_adr_0206_coverage_claims_are_proposals_and_the_kernel_resolves_them_coverage_claims_are_proposals_and_the_kernel_resolves_them","label":"Coverage Claims are proposals and the Kernel resolves them","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0206-coverage-claims-are-proposals-and-the-kernel-resolves-them.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Producer claims do not establish coverage; the kernel independently verifies admission, obligation rules, eligibility, evidence, independence, overflow, gaps, and lineage."},
