    {"id":"docs_adr_0208_not_applicable_requires_eligible_negative_proof_not_applicable_requires_eligible_negative_proof","label":"NOT_APPLICABLE requires eligible negative proof","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0208-not-applicable-requires-eligible-negative-proof.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Non-applicability requires qualified inventory, scope selection, and negative evidence tied to the exact selector and plan version; later contradictory facts require a new resolution."},
    {"id":"docs_adr_0209_coverage_hierarchy_requires_every_mandatory_child_coverage_hierarchy_requires_every_mandatory_child","label":"Coverage hierarchy requires every mandatory child","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0209-coverage-hierarchy-requires-every-mandatory-child.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A parent is satisfied only when each mandatory descendant is satisfied or independently proved not applicable; aggregate strength cannot mask a child gap."},
    {"id":"docs_adr_0210_advisory_work_cannot_compensate_for_mandatory_gaps_advisory_work_cannot_compensate_for_mandatory_gaps","label":"Advisory work cannot compensate for mandatory gaps","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0210-advisory-work-cannot-compensate-for-mandatory-gaps.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Optional breadth may enrich evidence but cannot satisfy, downgrade, weight away, or hide a mandatory coverage gap."},
    {"id":"docs_adr_0211_policy_significance_is_derived_by_a_deterministic_rule_trace_policy_significance_is_derived_by_a_deterministic_rule_trace","label":"Policy Significance is derived by a deterministic rule trace","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0211-policy-significance-is-derived-by-a-deterministic-rule-trace.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Policy significance is deterministically derived from exact policy, scope, severity, confidence, lineage, risk acceptance, and controls with every input preserved in a trace."},
    {"id":"docs_adr_0212_policy_evaluation_uses_one_recorded_instant_policy_evaluation_uses_one_recorded_instant","label":"Policy Evaluation uses one recorded instant","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0212-policy-evaluation-uses-one-recorded-instant.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"All freshness and expiry rules in final evaluation use one committed host-provided instant rather than ambient clocks."},
    {"id":"docs_adr_0213_a_proven_blocking_violation_takes_precedence_over_incomplete_coverage_a_proven_blocking_violation_takes_precedence_over_incomplete_coverage","label":"A proven blocking violation takes precedence over incomplete Coverage","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0213-a-proven-blocking-violation-takes-precedence-over-incomplete-coverage.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A proved unaccepted blocking finding yields FAILED despite gaps; absent such proof, mandatory gaps yield INDETERMINATE and only complete mandatory coverage without blockers yields SATISFIED."},
    {"id":"docs_adr_0214_the_policy_evaluator_is_pure_and_emits_a_complete_trace_the_policy_evaluator_is_pure_and_emits_a_complete_trace","label":"The Policy Evaluator is pure and emits a complete trace","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0214-the-policy-evaluator-is-pure-and-emits-a-complete-trace.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Equal frozen canonical inputs under one evaluator version produce byte-equivalent verdict candidates and traces without I/O, time, provider, model, or state-transition effects."},
    {"id":"docs_adr_0215_sealing_requires_an_independent_deterministic_readiness_check_sealing_requires_an_independent_deterministic_readiness_check","label":"Sealing requires an independent deterministic Readiness Check","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0215-sealing-requires-an-independent-deterministic-readiness-check.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"An independent kernel check verifies terminal work, resolved obligations, closed authority, consistent revisions and chains, trace agreement, and generatable artifacts before atomic sealing."},
    {"id":"docs_adr_0216_release_conformance_targets_a_packed_fresh_harness_installation_release_conformance_targets_a_packed_fresh_harness_installation","label":"Release Conformance targets a packed fresh Harness installation","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0216-release-conformance-targets-a-packed-fresh-harness-installation.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Release proof installs the exact packed artifact into a fresh declared Harness profile and exercises public plugin boundaries; source aliases and modified trees cannot establish release claims."},
    {"id":"docs_adr_0217_the_reference_test_host_uses_real_harness_composition_the_reference_test_host_uses_real_harness_composition","label":"The Reference Test Host uses real Harness composition","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0217-the-reference-test-host-uses-real-harness-composition.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The reference host uses actual Harness and Cordis loading, services, tools, remotes, client slots, and lifecycle with isolated per-test authority and no shared developer state."},
    {"id":"docs_adr_0218_tests_have_no_security_semantic_bypass_tests_have_no_security_semantic_bypass","label":"Tests have no security semantic bypass","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0218-tests-have-no-security-semantic-bypass.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Production exposes no test-only weakening path; deterministic dependencies use authenticated official seams and forensic inspection remains read-only and out of process."},
    {"id":"docs_adr_0219_deterministic_reference_fakes_exercise_official_seams_deterministic_reference_fakes_exercise_official_seams","label":"Deterministic Reference Fakes exercise official seams","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0219-deterministic-reference-fakes-exercise-official-seams.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Versioned fakes use real analyzer, provider, key, broker, and clock contracts to prove orchestration and failure conformance, but never count as effectiveness, qualification, claims, or customer evidence."},
