    {"id":"docs_adr_0221_crash_conformance_hard_kills_at_named_persistence_checkpoints_crash_conformance_hard_kills_at_named_persistence_checkpoints","label":"Crash Conformance hard-kills at named persistence checkpoints","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0221-crash-conformance-hard-kills-at-named-persistence-checkpoints.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Crash proof terminates the complete host at non-authorizing durable checkpoints, restarts against the same isolated root, and verifies recovery artifacts, fencing, and blocked outcomes."},
