    {"id":"cordis_patch_dormant_bundle_configuration","label":"Dormant Security Assurance Bundle Configuration","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\cordis.patch.yml","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"All Security Assurance runtime rows are installed disabled so deployment owners explicitly activate qualified capabilities."},
    {"id":"docs_adr_0001_security_assurance_is_an_independent_companion_product_decision","label":"Security Assurance Is an Independent Companion Product","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0001-security-assurance-is-an-independent-companion-product.md","source_location":"# Security Assurance is an independent companion product","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Preserve an independently useful security product while keeping Engineering Control Plane governance provider-neutral."},
    {"id":"docs_adr_0002_security_verdicts_do_not_own_mission_approval_decision","label":"Security Verdicts Do Not Own Mission Approval","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0002-security-verdicts-do-not-own-mission-approval.md","source_location":"# Security Verdicts do not own Mission approval","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The Control Plane must remain the sole authority over Mission approval, rework, and operational indeterminacy."},
    {"id":"docs_adr_0003_codex_security_is_a_reference_not_a_required_runtime_decision","label":"Codex Security Is a Reference, Not a Required Runtime","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0003-codex-security-is-a-reference-not-a-required-runtime.md","source_location":"# Codex Security is a reference, not a required runtime","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"DSH owns its contracts and avoids copying private Codex implementation or requiring a Codex-specific runtime."},
    {"id":"docs_adr_0004_security_claims_are_scope_and_coverage_bound_decision","label":"Security Claims Are Scope and Coverage Bound","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0004-security-claims-are-scope-and-coverage-bound.md","source_location":"# Security claims are scope- and coverage-bound","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Missing required coverage must produce an indeterminate verdict; successful execution or zero findings cannot imply satisfaction."},
    {"id":"docs_adr_0005_one_assessment_engine_serves_both_entry_points_decision","label":"One Assessment Engine Serves Both Entry Points","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0005-one-assessment-engine-serves-both-entry-points.md","source_location":"# One Assessment Engine serves both entry points","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Standalone and Control Plane entry points must preserve one evidence and verdict meaning for equivalent frozen inputs."},
    {"id":"docs_adr_0006_security_assessments_bind_an_immutable_subject_decision","label":"Security Assessments Bind an Immutable Subject","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0006-security-assessments-bind-an-immutable-subject.md","source_location":"# Security Assessments bind an immutable Subject","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Exact identities and digests prevent later workspace mutation from changing what an Assessment evaluated."},
    {"id":"docs_adr_0007_host_policy_and_a_deterministic_evaluator_own_verdict_semantics_decision","label":"Host Policy and a Deterministic Evaluator Own Verdict Semantics","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0007-host-policy-and-a-deterministic-evaluator-own-verdict-semantics.md","source_location":"# Host Policy and a deterministic evaluator own Verdict semantics","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Analyzers contribute evidence, findings, and coverage, while only frozen policy and deterministic evaluation derive the verdict."},
    {"id":"docs_adr_0008_security_verdicts_are_tristate_and_fail_closed_decision","label":"Security Verdicts Are Tristate and Fail Closed","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0008-security-verdicts-are-tristate-and-fail-closed.md","source_location":"# Security Verdicts are tristate and fail closed","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Satisfied requires complete eligible coverage and no blocking finding; proven violations fail, and uncertainty remains indeterminate."},
    {"id":"docs_adr_0009_evidence_storage_does_not_modify_the_assessment_subject_decision","label":"Evidence Storage Does Not Modify the Assessment Subject","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0009-evidence-storage-does-not-modify-the-assessment-subject.md","source_location":"# Evidence storage does not modify the Assessment Subject","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Canonical evidence remains plugin-owned so assessment activity cannot mutate or trust target-controlled records."},
    {"id":"docs_adr_0010_assurance_integration_exchanges_sealed_submissions_decision","label":"Assurance Integration Exchanges Sealed Submissions","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0010-assurance-integration-exchanges-sealed-submissions.md","source_location":"# Assurance integration exchanges sealed submissions","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Separate products exchange immutable digest-bound values instead of sharing stores, tables, or writable paths."},
    {"id":"docs_adr_0011_assessment_state_and_security_verdict_are_separate_decision","label":"Assessment State and Security Verdict Are Separate","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0011-assessment-state-and-security-verdict-are-separate.md","source_location":"# Assessment State and Security Verdict are separate","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Operational progress and resumability must not be confused with a sealed security conclusion."},
    {"id":"docs_adr_0012_standalone_use_exposes_assessment_control_not_a_second_mission_system_decision","label":"Standalone Use Exposes Assessment Control, Not a Second Mission System","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0012-standalone-use-exposes-assessment-control-not-a-second-mission-system.md","source_location":"# Standalone use exposes Assessment control, not a second Mission system","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Standalone operations control the shared Assessment Engine without duplicating Control Plane Mission or Quality Gate concepts."},
    {"id":"docs_adr_0013_v1_assessment_is_read_only_decision","label":"V1 Assessment Is Read Only","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0013-v1-assessment-is-read-only.md","source_location":"# V1 assessment is read-only","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Assessment may propose remediation, but subject mutation belongs to a separately authorized workflow and a later independently assessed subject."},
    {"id":"docs_adr_0014_host_policy_controls_provider_activation_decision","label":"Host Policy Controls Provider Activation","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0014-host-policy-controls-provider-activation.md","source_location":"# Host Policy controls Provider activation","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Installation or registration grants no obligation; the host freezes activation and providers cannot weaken the plan."},
    {"id":"docs_adr_0015_machine_providers_have_explicit_assessor_identity_decision","label":"Machine Providers Have Explicit Assessor Identity","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0015-machine-providers-have-explicit-assessor-identity.md","source_location":"# Machine Providers have explicit Assessor identity","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Machine provider lineage must be explicit and cannot impersonate independent agent or human review."},
    {"id":"docs_adr_0016_provider_capability_describes_support_but_grants_no_permission_decision","label":"Provider Capability Describes Support but Grants No Permission","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0016-provider-capability-describes-support-but-grants-no-permission.md","source_location":"# Provider Capability describes support but grants no permission","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Capability declarations inform policy and composition but never authorize access to code, processes, or networks."}
