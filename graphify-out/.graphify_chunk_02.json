{
  "nodes": [
    {"id":"docs_adr_0017_gate_bearing_assessment_requires_bounded_execution_gate_bearing_assessment_requires_bounded_execution","label":"Gate-bearing assessment requires bounded execution","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0017-gate-bearing-assessment-requires-bounded-execution.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Provider work must run in a bounded execution context; a backend whose identity, execution, coverage, or evidence cannot be bounded may contribute only advisory findings."},
    {"id":"docs_adr_0018_provider_composition_is_frozen_into_the_assessment_seal_provider_composition_is_frozen_into_the_assessment_seal","label":"Provider Composition is frozen into the Assessment Seal","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0018-provider-composition-is-frozen-into-the-assessment-seal.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The seal binds every component that can affect assessment semantics, so changing any bound component requires a new assessment."},
    {"id":"docs_adr_0019_coverage_is_proven_against_a_frozen_plan_coverage_is_proven_against_a_frozen_plan","label":"Coverage is proven against a frozen Plan","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0019-coverage-is-proven-against-a-frozen-plan.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Coverage must be reconciled against a deterministic plan derived before analysis; an unsupported mandatory item prevents a satisfied verdict."},
    {"id":"docs_adr_0020_assessment_executes_as_a_durable_phase_graph_assessment_executes_as_a_durable_phase_graph","label":"Assessment executes as a durable phase graph","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0020-assessment-executes-as-a-durable-phase-graph.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Assessment work is persisted as an evidence-producing dependency graph rather than one long agent conversation."},
    {"id":"docs_adr_0021_assessment_modes_bound_the_breadth_of_security_claims_assessment_modes_bound_the_breadth_of_security_claims","label":"Assessment Modes bound the breadth of security claims","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0021-assessment-modes-bound-the-breadth-of-security-claims.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Repository, Change, and Targeted modes bind different subjects and may not imply broader coverage without policy-authorized baseline evidence."},
    {"id":"docs_adr_0022_policy_layers_may_strengthen_but_not_weaken_the_baseline_policy_layers_may_strengthen_but_not_weaken_the_baseline","label":"Policy layers may strengthen but not weaken the baseline","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0022-policy-layers-may-strengthen-but-not-weaken-the-baseline.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Policy layers compose monotonically and unknown, contradictory, or uncompilable requirements fail closed."},
    {"id":"docs_adr_0023_analyzers_enter_through_a_versioned_startup_registry_analyzers_enter_through_a_versioned_startup_registry","label":"Analyzers enter through a versioned startup Registry","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0023-analyzers-enter-through-a-versioned-startup-registry.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Analyzer capabilities, schemas, budgets, and runtime conditions must be declared before assessment creation; mid-assessment loading is forbidden."},
    {"id":"docs_adr_0024_provider_unavailability_is_distinct_from_an_invalid_contribution_provider_unavailability_is_distinct_from_an_invalid_contribution","label":"Provider unavailability is distinct from an invalid contribution","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0024-provider-unavailability-is-distinct-from-an-invalid-contribution.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Optional unavailability is diagnostic, structural invalidity causes safe read-only startup, and loss of a frozen provider blocks the assessment without substitution."},
    {"id":"docs_adr_0025_analyzer_failure_requires_explicit_resume_analyzer_failure_requires_explicit_resume","label":"Analyzer failure requires explicit Resume","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0025-analyzer-failure-requires-explicit-resume.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Analyzer attempts are durable and budget charged; failure blocks the assessment and only explicit resume may create another attempt under the same frozen inputs."},
    {"id":"docs_adr_0026_cancellation_preserves_partial_evidence_but_produces_no_verdict_cancellation_preserves_partial_evidence_but_produces_no_verdict","label":"Cancellation preserves partial Evidence but produces no Verdict","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0026-cancellation-preserves-partial-evidence-but-produces-no-verdict.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Cancellation fences further execution and preserves partial evidence, but the canceled assessment has no security verdict."},
    {"id":"docs_adr_0027_only_sealed_assessments_produce_assurance_submissions_only_sealed_assessments_produce_assurance_submissions","label":"Only sealed Assessments produce Assurance Submissions","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0027-only-sealed-assessments-produce-assurance-submissions.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Only an integrity-valid sealed assessment may submit an assurance result; blocked or canceled work remains an operational failure."},
    {"id":"docs_adr_0028_severity_confidence_and_policy_significance_are_independent_severity_confidence_and_policy_significance_are_independent","label":"Severity, confidence, and Policy Significance are independent","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0028-severity-confidence-and-policy-significance-are-independent.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Technical severity, evidence confidence, and policy significance record different meanings and must not be collapsed into scanner labels or aggregate scores."},
    {"id":"docs_adr_0029_risk_acceptance_is_authorized_scoped_and_non_destructive_risk_acceptance_is_authorized_scoped_and_non_destructive","label":"Risk Acceptance is authorized, scoped, and non-destructive","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0029-risk-acceptance-is-authorized-scoped-and-non-destructive.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Risk acceptance is immutable, authorized, and precisely bound; it may alter policy significance but cannot erase or downgrade the underlying finding."},
    {"id":"docs_adr_0030_v1_has_one_complete_supported_ecosystem_v1_has_one_complete_supported_ecosystem","label":"V1 has one complete Supported Ecosystem","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0030-v1-has-one-complete-supported-ecosystem.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Complete V1 coverage claims are limited to TypeScript, JavaScript, and Node.js until tested analyzers and coverage contracts extend the support matrix."},
    {"id":"docs_adr_0031_standard_and_deep_share_policy_but_differ_in_variance_reduction_standard_and_deep_share_policy_but_differ_in_variance_reduction","label":"Standard and Deep share Policy but differ in variance reduction","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0031-standard-and-deep-share-policy-but-differ-in-variance-reduction.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Both profiles enforce the same policy and verdict rules, while Deep adds independent discovery and validation lineages until a frozen convergence or budget condition."},
    {"id":"docs_adr_0032_specialist_agents_remain_subordinate_to_the_assessment_engine_specialist_agents_remain_subordinate_to_the_assessment_engine","label":"Specialist agents remain subordinate to the Assessment Engine","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0032-specialist-agents-remain-subordinate-to-the-assessment-engine.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Specialist roles may contribute candidates and evidence but cannot mutate policy, grant waivers, modify the subject, or decide the verdict."},
    {"id":"docs_adr_0033_threat_models_are_versioned_evidence_threat_models_are_versioned_evidence","label":"Threat Models are versioned Evidence","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0033-threat-models-are-versioned-evidence.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Threat models are first-class evidence artifacts and may be reused only under exact identity, inventory, policy, and reuse-contract compatibility."},
    {"id":"docs_adr_0034_change_assessment_covers_an_impact_cone_not_only_diff_lines_change_assessment_covers_an_impact_cone_not_only_diff_lines","label":"Change Assessment covers an impact cone, not only diff lines","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0034-change-assessment-covers-an-impact-cone-not-only-diff-lines.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Change assessment expands the exact diff across dependent code, trust boundaries, permissions, configuration, and tests; an unprovable cone yields expansion or indeterminate coverage."},
    {"id":"docs_adr_0035_findings_require_explicit_validation_state_findings_require_explicit_validation_state","label":"Findings require explicit Validation state","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0035-findings-require-explicit-validation-state.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Candidate findings must become validated, rejected with counter-evidence, or unresolved under an eligible evidence contract."},
    {"id":"docs_adr_0036_source_and_evidence_egress_is_deny_by_default_source_and_evidence_egress_is_deny_by_default","label":"Source and Evidence egress is deny by default","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0036-source-and-evidence-egress-is-deny-by-default.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Remote analyzers receive only authorized minimum source slices under a frozen egress contract, and secrets never enter remote inputs or human-readable reports."},
    {"id":"docs_adr_0037_cross_assessment_evidence_reuse_is_contract_verified_cross_assessment_evidence_reuse_is_contract_verified","label":"Cross-Assessment Evidence reuse is contract-verified","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0037-cross-assessment-evidence-reuse-is-contract-verified.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Prior evidence is reusable only when its contract proves lineage, digests, policy, provider composition, schema, validity, and impact compatibility; reused records enter the new seal."},
