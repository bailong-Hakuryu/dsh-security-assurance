{
  "nodes": [
    {"id":"docs_adr_0185_weakness_classification_is_versioned_namespaced_and_explicit_about_unknowns_decision","label":"Weakness Classification Is Versioned, Namespaced, and Explicit About Unknowns","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0185-weakness-classification-is-versioned-namespaced-and-explicit-about-unknowns.md","source_location":"# Weakness Classification is versioned namespaced and explicit about Unknowns","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Canonical weakness identities come from qualified taxonomies, while UNKNOWN prevents unjustifiably permissive validation."},
    {"id":"docs_adr_0186_source_anchors_bind_subject_content_and_stable_spans_decision","label":"Source Anchors Bind Subject Content and Stable Spans","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0186-source-anchors-bind-subject-content-and-stable-spans.md","source_location":"# Source Anchors bind Subject content and stable spans","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Content digests and byte spans bind findings to frozen subject bytes instead of mutable workspace line numbers."},
    {"id":"docs_adr_0187_evidence_kinds_use_a_versioned_core_registry_decision","label":"Evidence Kinds Use a Versioned Core Registry","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0187-evidence-kinds-use-a-versioned-core-registry.md","source_location":"# Evidence kinds use a versioned core registry","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Typed registered evidence schemas give artifacts semantic meaning; unknown kinds remain opaque and ineligible for mandatory proof."},
    {"id":"docs_adr_0188_the_kernel_decides_evidence_eligibility_per_claim_and_contract_decision","label":"The Kernel Decides Evidence Eligibility per Claim and Contract","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0188-the-kernel-decides-evidence-eligibility-per-claim-and-contract.md","source_location":"# The Kernel decides Evidence Eligibility per Claim and Contract","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Eligibility is immutable and purpose-specific to an exact claim, contract, subject, evidence identity, provenance, freshness, and controls."},
    {"id":"docs_adr_0189_the_kernel_freezes_validation_contract_resolution_decision","label":"The Kernel Freezes Validation Contract Resolution","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0189-the-kernel-freezes-validation-contract-resolution.md","source_location":"# The Kernel freezes Validation Contract Resolution","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The exact qualified validation contract is selected before results exist, preventing actors from choosing an easier contract post hoc."},
    {"id":"docs_adr_0190_validation_outcomes_are_validated_rejected_or_unresolved_decision","label":"Validation Outcomes Are VALIDATED, REJECTED, or UNRESOLVED","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0190-validation-outcomes-are-validated-rejected-or-unresolved.md","source_location":"# Validation Outcomes are VALIDATED, REJECTED, or UNRESOLVED","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Tri-state outcomes preserve unmet proof burdens instead of collapsing uncertainty into a guessed Boolean."},
    {"id":"docs_adr_0191_rejection_requires_contract_satisfying_counter_evidence_decision","label":"Rejection Requires Contract-Satisfying Counter-Evidence","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0191-rejection-requires-contract-satisfying-counter-evidence.md","source_location":"# Rejection requires contract-satisfying Counter-Evidence","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Failure to reproduce or exhaustively validate is not counter-proof; rejection requires evidence satisfying the frozen rejection condition."},
    {"id":"docs_adr_0192_independent_validation_is_established_from_the_provenance_graph_decision","label":"Independent Validation Is Established from the Provenance Graph","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0192-independent-validation-is-established-from-the-provenance-graph.md","source_location":"# Independent Validation is established from the provenance graph","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Independence depends on complete ancestry across models, providers, prompts, analyzers, tools, evidence, and contributions, not merely different attempt IDs."},
    {"id":"docs_adr_0193_attack_paths_are_typed_evidence_graphs_with_explicit_unknowns_decision","label":"Attack Paths Are Typed Evidence Graphs with Explicit Unknowns","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0193-attack-paths-are-typed-evidence-graphs-with-explicit-unknowns.md","source_location":"# Attack Paths are typed Evidence graphs with explicit unknowns","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Typed directed evidence edges retain assumptions and known, disproved, or unknown states so missing proof remains visible."},
    {"id":"docs_adr_0194_technical_severity_uses_a_versioned_evidence_derived_method_decision","label":"Technical Severity Uses a Versioned Evidence-Derived Method","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0194-technical-severity-uses-a-versioned-evidence-derived-method.md","source_location":"# Technical Severity uses a versioned Evidence-derived method","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Canonical severity is calculated from frozen evidence-backed dimensions and remains separate from policy significance and risk acceptance."},
    {"id":"docs_adr_0195_evidence_confidence_uses_a_deterministic_multidimensional_rubric_decision","label":"Evidence Confidence Uses a Deterministic Multidimensional Rubric","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0195-evidence-confidence-uses-a-deterministic-multidimensional-rubric.md","source_location":"# Evidence Confidence uses a deterministic multidimensional rubric","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Explainable component grades over proof quality, qualification, reproducibility, independence, binding, freshness, controls, and gaps replace model probability or votes."},
    {"id":"docs_adr_0196_candidate_overflow_creates_an_explicit_coverage_gap_decision","label":"Candidate Overflow Creates an Explicit Coverage Gap","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0196-candidate-overflow-creates-an-explicit-coverage-gap.md","source_location":"# Candidate Overflow creates an explicit Coverage gap","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Quota exhaustion must create a visible coverage gap rather than silently treating the processed candidate subset as complete."},
    {"id":"docs_adr_0197_evidence_links_bind_each_use_to_claim_contract_and_eligibility_decision","label":"Evidence Links Bind Each Use to Claim, Contract, and Eligibility","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0197-evidence-links-bind-each-use-to-claim-contract-and-eligibility.md","source_location":"# Evidence Links bind each use to Claim, Contract, and Eligibility","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Each authoritative evidence use is independently bound to its claim, contract, eligibility, lineage, digest, and consumer without transitive trust."},
    {"id":"docs_adr_0198_security_policies_are_versioned_declarative_data_decision","label":"Security Policies Are Versioned Declarative Data","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0198-security-policies-are-versioned-declarative-data.md","source_location":"# Security Policies are versioned declarative data","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A typed non-executable policy language compiles deterministically and rejects unknown constructs instead of using model interpretation or arbitrary code."},
    {"id":"docs_adr_0199_policy_layers_preserve_source_identity_and_trust_decision","label":"Policy Layers Preserve Source Identity and Trust","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0199-policy-layers-preserve-source-identity-and-trust.md","source_location":"# Policy Layers preserve source identity and trust","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Baseline, host, organization, and permitted repository strengthening layers retain distinct identity, authority, scope, digest, and provenance."},
    {"id":"docs_adr_0200_policy_composition_is_monotonic_and_conflicts_fail_closed_decision","label":"Policy Composition Is Monotonic and Conflicts Fail Closed","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0200-policy-composition-is-monotonic-and-conflicts-fail-closed.md","source_location":"# Policy composition is monotonic and conflicts fail closed","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Lower-trust layers may only strengthen inherited rules, and contradictory or unsupported compositions fail closed."},
    {"id":"docs_adr_0201_policy_compilation_is_deterministic_and_recorded_decision","label":"Policy Compilation Is Deterministic and Recorded","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0201-policy-compilation-is-deterministic-and-recorded.md","source_location":"# Policy compilation is deterministic and recorded","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Equal explicit inputs produce identical policy AST, coverage plan, diagnostics, and digests, with complete compilation lineage sealed."},
    {"id":"docs_adr_0202_coverage_planning_requires_an_evidence_backed_subject_inventory_decision","label":"Coverage Planning Requires an Evidence-Backed Subject Inventory","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0202-coverage-planning-requires-an-evidence-backed-subject-inventory.md","source_location":"# Coverage planning requires an Evidence-backed Subject Inventory","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Coverage planning begins from evidence-backed components and boundaries; unknown or unsupported relevant regions become typed inventory gaps."},
    {"id":"docs_adr_0203_coverage_obligations_are_stable_typed_completion_contracts_decision","label":"Coverage Obligations Are Stable Typed Completion Contracts","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0203-coverage-obligations-are-stable-typed-completion-contracts.md","source_location":"# Coverage Obligations are stable typed completion contracts","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Stable typed obligations bind scope, evidence, independence, eligibility, dependencies, budget, and exact completion rules independently of later resolution."},
    {"id":"docs_adr_0204_the_coverage_plan_is_an_immutable_obligation_dependency_graph_decision","label":"The Coverage Plan Is an Immutable Obligation Dependency Graph","file_type":"rationale","source_file":"D:\\Deepseek\\DSH  Security Assurance\\docs\\adr\\0204-the-coverage-plan-is-an-immutable-obligation-dependency-graph.md","source_location":"# The Coverage Plan is an immutable Obligation dependency graph","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A frozen acyclic graph of obligations and barriers defines prerequisites, parallelism, and completion before execution begins."},
